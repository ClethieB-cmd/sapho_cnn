// --- arrays globais (substituem os parametros do tipo array) ---
float dense3_W[32];
float dense3_b[1];
float entrada[32];
float saida[1];

float buf_input[7];
float buf_conv1[224];
float conv1_kernel[160];
float conv1_bias[32];
float bn1_gamma[32];
float bn1_beta[32];
float bn1_mean[32];
float bn1_var[32];

float relu(float x) {
    if (x > 0) return x;
    return 0.0;
}
float fast_sqrt(float x) {
    if (x <= 0) return 0.0;
    float y;
    y = 1.0;
    y = (y + x/y) * 0.5;
    y = (y + x/y) * 0.5;
    y = (y + x/y) * 0.5;
    y = (y + x/y) * 0.5;
    return y;
}
void conv1d_1(int in_len, int in_ch,
              int out_ch, int ksize,
              int use_relu) {
    int pad;
    int pos;
    int f;
    int k;
    int src;
    int c;
    float acc;
    pad = ksize / 2;
    pos = 0;
    while (pos < in_len) {
        f = 0;
        while (f < out_ch) {
            acc = conv1_bias[f];
            k = 0;
            while (k < ksize) {
                src = pos + k - pad;
                if (src > -1 && src < in_len) {
                    c = 0;
                    while (c < in_ch) {
                        acc = acc + buf_input[src*in_ch+c]
                                  * conv1_kernel[(f*ksize+k)*in_ch+c];
                        c = c + 1;
                    }
                }
                k = k + 1;
            }
            if (use_relu) buf_conv1[pos*out_ch+f] = relu(acc);
            else          buf_conv1[pos*out_ch+f] = acc;
            f = f + 1;
        }
        pos = pos + 1;
    }
}
void batch_norm_1(int len, int n_ch) {
    int pos;
    int c;
    float x;
    float inv;
    pos = 0;
    while (pos < len) {
        c = 0;
        while (c < n_ch) {
            x = buf_conv1[pos*n_ch + c];
            inv = 1.0 / fast_sqrt(bn1_var[c] + 0.001);
            buf_conv1[pos*n_ch + c] = bn1_gamma[c] * (x - bn1_mean[c]) * inv + bn1_beta[c];
            c = c + 1;
        }
        pos = pos + 1;
    }
}
// dense: le 'entrada', 'dense3_W', 'dense3_b' e escreve em 'saida'
// parametros sao apenas escalares (tamanhos e flag)
void dense(int in_size, int out_size, int use_relu) {
    int k;
    int j;
    float acc;
    j = 0;
    while (j < out_size) {
        acc = dense3_b[j];
        k = 0;
        while (k < in_size) {
            acc = acc + entrada[k] * dense3_W[k*out_size + j];
            k = k + 1;
        }
        if (use_relu) saida[j] = relu(acc);
        else          saida[j] = acc;
        j = j + 1;
    }
}

